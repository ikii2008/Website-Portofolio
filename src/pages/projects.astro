---
import Layout from "../layout/layout.astro";
---

<Layout title="Project">
  <div class="flex flex-col flex-1 min-h-0">
    <div
      class="flex text-sky-400 p-2 min-w-screen bg-slate-900/50 border-b border-slate-800 justify-center items-center font-mono font-bold tracking-wider text-2xl uppercase"
    >
      [ PROJECTS ]
    </div>

    <div class="flex flex-row flex-1 w-lvw min-h-0">
      <div
        id="file-tree"
        class="flex flex-col w-[25%] h-full overflow-y-auto p-4"
      >
      </div>
      <div
        class="flex flex-col w-[75%] border-l border-slate-800 bg-gray-950/80 overflow-y-auto"
      >
        <div
          id="loading-spinner"
          class="hidden absolute flex flex-col items-center gap-3"
        >
          <div
            class="animate-spin rounded-full h-10 w-10 border-b-2 border-cyan-400"
          >
          </div>
          <div class="text-slate-500 font-mono text-xs">Memuat...</div>
        </div>
        <div
          id="file-viewer"
          class="block h-full w-full p-4 overflow-y-auto prose prose-invert prose-slate max-w-none
            font-sans tracking-normal
            prose-headings:font-sans prose-headings:tracking-normal
            prose-h1:text-3xl prose-h1:font-bold prose-h1:pb-2 prose-h1:border-b prose-h1:border-slate-700 prose-h1:mb-4
            prose-h2:text-xl prose-h2:font-semibold prose-h2:pb-2 prose-h2:border-b prose-h2:border-slate-700 prose-h2:mt-8 prose-h2:mb-4
            prose-hr:border-slate-600 prose-hr:my-6
            prose-table:border prose-hr:border-t-4 prose-table:!w-auto prose-table:!table-auto prose-td:whitespace-nowrap prose-table:border-slate-700 prose-table:rounded-md prose-table:overflow-hidden
            prose-thead:bg-slate-800/50
            prose-th:border prose-th:border-slate-700 prose-th:px-3 prose-th:py-1.5 prose-th:text-left
            prose-td:border prose-td:border-slate-700 prose-td:px-3 prose-td:py-1.5
            prose-code:bg-slate-800 prose-code:text-cyan-300 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
            prose-pre:font-mono"
        >
        </div>
      </div>
    </div>
  </div>
</Layout>
