---
import Layout from "../layout/layout.astro";

const fileImport = import.meta.glob("/src/content/terminal/*", {
  query: "?raw",
  import: "default",
  eager: true,
});
const file = {};

for (const path in fileImport) {
  const fileName = path.split("/").pop();
  file[fileName] = fileImport[path];
}

const filesJson = JSON.stringify(file);
---

<html lang="en">
  <Layout title="Home">
    <main
      class="flex-1 flex items-center justify-between px-16 max-w-7xl mx-auto w-full gap-8"
    >
      <div class="flex flex-col items-start gap-4 max-w-xl">
        <p class="font-mono text-xs text-emerald-400 tracking-wider">
          [ System.Status: Active ]
        </p>
        <h1 class="text-4xl font-extrabold text-white">Wiki Dwi Saputra</h1>
        <h2 class="text-lg text-slate-400 font-medium -mt-2">
          Network & Cyber Security Enthusiast
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed text-justify">
          Lulusan SMK jurusan Teknik Jaringan Komputer dan Telekomunikasi tahun
          2026 dengan fokus pada bidang Networking serta mengembangkan keahlian
          di bidang Cybersecurity. Aktif mendokumentasikan write-up CTF serta
          mengembangkan script otomatisasi pengujian kriptografi (PRNG LCG) dan
          script otomatisasi hyprland.
        </p>

        <div class="flex flex-wrap gap-2 my-1">
          <span
            class="bg-emerald-950/80 text-emerald-400 text-xs px-3 py-1 rounded-full border border-emerald-800/50"
          >
            🏆 2x Juara 2 LKS Kabupaten
          </span>
          <span
            class="bg-slate-800 text-cyan-400 text-xs px-3 py-1 rounded-full border border-slate-700"
          >
            Linux & Offensive Sec
          </span>
        </div>

        <div class="flex items-center gap-4 mt-2">
          <a
            href="/resume.pdf"
            download="CV-Wiki.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold px-5 py-2.5 rounded-lg text-sm transition"
          >
            Download CV
          </a>
          <div class="flex gap-2">
            <a
              href="https://github.com/ikii2008"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-slate-900 border border-slate-800 w-[52px] h-[52px] flex items-center justify-center rounded-lg hover:bg-slate-800 transition"
            >
              <i class="fa-brands fa-github text-slate-50 text-[26px]"></i>
            </a>
            <a
              href="https://www.linkedin.com/in/wiki-dwi-saputra-9a7402390/"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-slate-900 border border-slate-800 w-[52px] h-[52px] flex items-center justify-center rounded-lg hover:bg-slate-800 transition"
            >
              <i class="fa-brands fa-linkedin text-slate-50 text-[26px]"></i>
            </a>
            <a
              href="https://www.instagram.com/wkii_07/"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-slate-900 border border-slate-800 w-[52px] h-[52px] flex items-center justify-center rounded-lg hover:bg-slate-800 transition"
            >
              <i class="fa-brands fa-instagram text-slate-50 text-[26px]"></i>
            </a>
          </div>
        </div>
      </div>

      <div
        class="relative bg-emerald-950/40 border border-emerald-900/50 w-[420px] h-[480px] rounded-2xl flex-shrink-0 overflow-hidden flex flex-col p-4 font-mono text-sm"
      >
        <div
          id="terminal-output"
          data-files={filesJson}
          class="flex-1 overflow-y-auto space-y-2 text-emerald-400"
        >
          <div>
            Welcome to wiki.cybersec terminal. Type 'help' for commands.
          </div>
        </div>
        <div class="self-start w-full h-[2px] bg-emerald-500"></div>
        <div class="flex items-center gap-2 mt-2">
          <span class="text-emerald-500 font-bold">&gt;</span>
          <input
            id="terminal-input"
            type="text"
            class="w-full bg-transparent border-none outline-none text-emerald-300 focus:ring-0 p-0"
            autofocus
          />
        </div>
      </div>
    </main>
  </Layout>
</html>
