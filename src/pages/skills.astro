---
import Layout from "../layout/layout.astro";
---

<html lang="en">
  <Layout title="Skills">
    <div
      class="flex text-sky-400 h-[30px] p-8 min-w-screen bg-slate-900/50 border-b border-slate-800 justify-center items-center font-mono font-bold tracking-wider text-2xl uppercase"
    >
      [ SKILLS ]
    </div>
    <div class="grid grid-cols-4 min-h-screen min-w-screen">
      <div class="flex items-start justify-center min-h-screen min-w-screen">
        <div
          class="flex flex-col items-start justify-start min-h-screen w-[25%] font-mono text-xl border-r border-slate-800 text-cyan-400 tracking-wider"
        >
          <div
            class="flex items-center justify-center h-[30px] p-8 w-full font-bold font-mono text-xl border-b border-slate-800 text-cyan-400 tracking-wider"
          >
            Technical
          </div>
          <div
            class="flex flex-col items-start justify-start h-full w-full font-mono text-xl text-cyan-400 tracking-wider p-4 gap-1"
          >
            <div class="flex gap-2">
              <span>-</span>
              <span>Penetration Testing</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Cybersecurity Tools (Nmap, Burp Suite)</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Python</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>HTML</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Shell</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Linux</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Windows</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Computer</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Computer Networking (Routing, Switching, MikroTik)</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Microsoft Word</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Microsoft Excel</span>
            </div>
          </div>
        </div>
        <div
          class="flex flex-col items-start justify-start min-h-screen w-[25%] font-mono text-xl border-r border-slate-800 text-cyan-400 tracking-wider"
        >
          <div
            class="flex items-center justify-center h-[30px] p-8 w-full font-bold font-mono text-xl border-b border-slate-800 text-cyan-400 tracking-wider"
          >
            Familiarity
          </div>
          <div
            class="flex flex-col items-start justify-start h-full w-full font-mono text-xl text-cyan-400 tracking-wider p-4 gap-1"
          >
            <div class="flex gap-2">
              <span>-</span>
              <span>OWASP Top 10</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>NIST CSF 2.0</span>
            </div>
          </div>
        </div>
        <div
          class="flex flex-col items-start justify-start min-h-screen w-[25%] font-mono text-xl border-r border-slate-800 text-cyan-400 tracking-wider"
        >
          <div
            class="flex items-center justify-center h-[30px] p-8 w-full font-mono font-bold text-xl border-b border-slate-800 text-cyan-400 tracking-wider"
          >
            Language
          </div>
          <div
            class="flex flex-col items-start justify-start h-full w-full font-mono text-xl text-cyan-400 tracking-wider p-4 gap-1"
          >
            <div class="flex gap-2">
              <span>-</span>
              <span>Indonesia (Native)</span>
            </div>
          </div>
        </div>
        <div
          class="flex flex-col items-start justify-start min-h-screen w-[25%] font-mono text-xl border-r border-slate-800 text-cyan-400 tracking-wider"
        >
          <div
            class="flex items-center justify-center h-[30px] p-8 w-full font-bold font-mono text-xl border-b border-slate-800 text-cyan-400 tracking-wider"
          >
            Interest
          </div>
          <div
            class="flex flex-col items-start justify-start h-full w-full font-mono text-xl text-cyan-400 tracking-wider p-4 gap-1"
          >
            <div class="flex gap-2">
              <span>-</span>
              <span>CTF Challenge</span>
            </div>
            <div class="flex gap-2">
              <span>-</span>
              <span>Linux Exploration</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Layout>
</html>
