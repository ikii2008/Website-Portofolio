---
import Layout from "../layout/layout.astro";
---

<Layout title="Contact">
  <div class="flex flex-col flex-1 min-h-0 items-center gap-10 pb-8">
    <div
      class="flex text-sky-400 p-2 min-w-screen bg-slate-900/50 border-b border-slate-800 justify-center items-center font-mono font-bold tracking-wider text-[3vh] md:text-2xl uppercase"
    >
      [ CONTACT ]
    </div>
    <div class="flex flex-col w-[80%] md:w-[50%] gap-8 flex-1 min-h-0">
      <form
        id="contact-form"
        action="https://formspree.io/f/xwlerwke"
        method="POST"
        class="flex flex-col w-full gap-4"
      >
        <input
          type="text"
          name="name"
          class="bg-gray-950/80 border border-slate-800 h-16 rounded-lg outline-none p-4"
          required
          placeholder="Your Name"
        />
        <input
          type="email"
          name="email"
          class="bg-gray-950/80 border border-slate-800 h-16 rounded-lg outline-none p-4"
          required
          placeholder="Your Email"
        />
        <textarea
          name="message"
          rows="5"
          class="bg-gray-950/80 border border-slate-800 h-[20vh] md:h-32 rounded-lg outline-none p-4"
          required
          placeholder="Type a message"></textarea>
        <button
          type="submit"
          class="bg-gray-950/80 border border-slate-800 h-8 w-16 rounded-lg outline-none"
          >Kirim</button
        >
      </form>
      <div id="form-status" class="hidden mt-4 text-sm"></div>
      <div
        class="flex flex-col font-mono text-center text-[2vh] md:text-lg text-cyan-400 mt-auto"
      >
        Or email directly to: wikidwisaputra07@gmail.com
      </div>
    </div>
  </div>
</Layout>
